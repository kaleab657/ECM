# 🚀 Render Deployment Environment Variables
# Copy these to your Render Dashboard -> Environment Variables

# 1. Cloudflare R2 (Storage for Car Images)
# IMPORTANT: You must configure the R2 bucket CORS policy. See R2_CORS_SETUP.md for details.
R2_ACCOUNT_ID=6f96d3c811cf3c906e78d24533b0ec96
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_LISTING_BUCKET=ethiocars-images
R2_LISTING_URL=https://pub-26cca08a18064198a206549a3e2eb1c1.r2.dev
R2_PAYMENT_BUCKET=payment-proofs
R2_PAYMENT_URL=https://pub-241e6fed684d40058707e17c356ae538.r2.dev

# 2. Firebase Admin (Backend Verification)
# Get this from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# IMPORTANT: Paste the entire JSON content as a single line string.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# 3. Gemini AI (Frontend)
# This is used by the frontend to communicate with Gemini.
VITE_GEMINI_API_KEY=your_gemini_api_key

# 4. App Configuration
NODE_ENV=production
PORT=3000
